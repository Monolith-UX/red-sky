# Copy to .env.local for local development; set the same names in Netlify for production.
# Never commit real values, and never prefix these with NEXT_PUBLIC_ — they are server-only.

# Supabase → Project Settings → API. The URL, and a secret key (sb_secret_…), or the
# legacy service_role key. With both set, the site stores everything in Supabase;
# without them it uses the JSON file in .data/.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Only for scripts/verify/lockout.mjs, which proves this public key can reach nothing.
# The site never uses it. Not needed in Netlify.
# SUPABASE_PUBLISHABLE_KEY=

# Optional: force the store, e.g. RED_SKY_STORE=file to run the e2e suite locally.
# RED_SKY_STORE=

# Comma-separated emails that may open /stories/review.
RED_SKY_MODERATORS=

# Comma-separated emails of staff accounts that may open /admin (lots, orders, messages,
# password resets). Unset, the moderators above are the staff.
# RED_SKY_ADMINS=

# Netlify build hook URL (Site configuration → Build & deploy → Build hooks). Saving a lot
# in /admin calls it, so the catalogue rebuilds and the change is live in ~3 minutes.
# NETLIFY_BUILD_HOOK=

# Optional: the site's public address for the sitemap. Netlify sets URL itself.
# SITE_URL=
